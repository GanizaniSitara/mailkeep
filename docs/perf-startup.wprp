<?xml version="1.0" encoding="utf-8"?>
<!-- this work item: bounded thread-wait and desktop composition capture. No disk/file/registry tracing. -->
<WindowsPerformanceRecorder Version="1.0" Author="Mailkeep">
  <Profiles>
    <SystemCollector Id="MailkeepSystem" Name="Mailkeep startup threads">
      <BufferSize Value="1024" />
      <Buffers Value="256" />
    </SystemCollector>
    <EventCollector Id="MailkeepGraphics" Name="Mailkeep startup graphics">
      <BufferSize Value="1024" />
      <Buffers Value="256" />
    </EventCollector>
    <SystemProvider Id="MailkeepThreads">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
      </Keywords>
      <Stacks>
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
      </Stacks>
    </SystemProvider>
    <EventProvider Id="Dwm" Name="Microsoft-Windows-Dwm-Core" Level="5">
      <Keywords><Keyword Value="0x1ffff" /></Keywords>
    </EventProvider>
    <EventProvider Id="Dxg" Name="Microsoft-Windows-DxgKrnl" Level="5">
      <Keywords><Keyword Value="0x65" /></Keywords>
    </EventProvider>
    <EventProvider Id="Win32k" Name="Microsoft-Windows-Win32k" Level="5">
      <Keywords><Keyword Value="0x42e3000" /></Keywords>
    </EventProvider>
    <Profile Id="MailkeepStartup.Verbose.File" Name="MailkeepStartup" Description="Mailkeep startup thread waits and composition" DetailLevel="Verbose" LoggingMode="File">
      <Collectors>
        <SystemCollectorId Value="MailkeepSystem"><SystemProviderId Value="MailkeepThreads" /></SystemCollectorId>
        <EventCollectorId Value="MailkeepGraphics">
          <EventProviders>
            <EventProviderId Value="Dwm" />
            <EventProviderId Value="Dxg" />
            <EventProviderId Value="Win32k" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
