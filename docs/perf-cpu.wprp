<?xml version="1.0" encoding="utf-8"?>
<!-- this work item: sampled CPU stacks and CLR method metadata only; no switches, graphics, disk or registry events. -->
<WindowsPerformanceRecorder Version="1.0" Author="Mailkeep">
  <Profiles>
    <SystemCollector Id="CpuSystem" Name="Mailkeep sampled CPU">
      <BufferSize Value="256" /><Buffers Value="256" />
    </SystemCollector>
    <EventCollector Id="CpuRuntime" Name="Mailkeep CLR symbols">
      <BufferSize Value="256" /><Buffers Value="256" />
    </EventCollector>
    <SystemProvider Id="CpuSamples">
      <Keywords><Keyword Value="ProcessThread" /><Keyword Value="Loader" /><Keyword Value="SampledProfile" /></Keywords>
      <Stacks><Stack Value="SampledProfile" /></Stacks>
    </SystemProvider>
    <EventProvider Id="CpuClr" Name="Microsoft-Windows-DotNETRuntime" Level="5" ProcessExeFilter="Mailkeep.WinForms.exe">
      <Keywords><Keyword Value="0x20038" /></Keywords>
      <CaptureStateOnSave><Keyword Value="0x70138" /></CaptureStateOnSave>
    </EventProvider>
    <EventProvider Id="CpuClrRundown" Name="Microsoft-Windows-DotNETRuntimeRundown" Level="5" CaptureStateOnly="true" ProcessExeFilter="Mailkeep.WinForms.exe">
      <CaptureStateOnSave><Keyword Value="0x70138" /></CaptureStateOnSave>
    </EventProvider>
    <Profile Id="MailkeepCpu.Verbose.File" Name="MailkeepCpu" Description="Sampled CPU with CLR symbols only" DetailLevel="Verbose" LoggingMode="File">
      <Collectors>
        <SystemCollectorId Value="CpuSystem"><SystemProviderId Value="CpuSamples" /></SystemCollectorId>
        <EventCollectorId Value="CpuRuntime"><EventProviders><EventProviderId Value="CpuClr" /><EventProviderId Value="CpuClrRundown" /></EventProviders></EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
